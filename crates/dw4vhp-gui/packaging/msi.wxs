<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Windows MSI installer: one exe into Program Files, a Start-menu shortcut,
  and the app icon for Add/Remove Programs. Built by the release workflow with
  WiX (`wix build`), a dotnet tool the runner installs on the fly.

  The MSI is built from the same CI exe as the zip — no rebuild, so both assets
  are the same binary. Nothing else ships in the MSI: like the zip, it carries
  no game data; every byte the app writes is derived from the player's own
  disc at runtime.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="DW4 Very Hard Plus"
      Manufacturer="DW4 Very Hard Plus"
      Version="$(Version)"
      UpgradeCode="bd9d3915-b839-48c7-ae79-afbf60a6cd78"
      Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="DW4 Very Hard Plus" />
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentGroupRef Id="AppComponents" />
    </Feature>

    <ComponentGroup Id="AppComponents" Directory="INSTALLFOLDER">
      <!-- One keypath per component (WIX0230): the exe component keys on
           the file, the marker component keys on the registry value. -->
      <Component Id="MainExe">
        <File Id="Dw4Exe" Source="$(BinDir)\dw4-veryhard-plus.exe" KeyPath="yes" />
        <Shortcut
            Id="StartMenuShortcut"
            Directory="ProgramMenuFolder"
            Name="DW4 Very Hard Plus"
            Icon="ProductIcon"
            IconIndex="0" />
      </Component>
      <Component Id="InstalledMarker">
        <RegistryValue
            Root="HKCU"
            Key="Software\DW4VeryHardPlus"
            Name="installed"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Icon Id="ProductIcon" SourceFile="$(Icon)" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
  </Package>
</Wix>
